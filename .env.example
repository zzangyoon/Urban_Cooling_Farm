# Database Configuration
DATABASE_URL=sqlite:///./urban_cooling.db

# Climate Platform API (경기기후플랫폼)
CLIMATE_API_BASE_URL=https://climate.gg.go.kr/ols/api/geoserver/wfs
CLIMATE_API_KEY=your_api_key_here

# App Settings
APP_NAME=Urban Cooling Farm
DEBUG=True

# Mock Mode (개발 시 True, 프로덕션 시 False)
USE_MOCK_DATA=True

# FastAPI Backend URL (Streamlit 앱에서 사용)
# 로컬 개발: http://localhost:8020
# Vercel 배포: https://your-project-name.vercel.app
FASTAPI_BASE_URL=http://localhost:8020
